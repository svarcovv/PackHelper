<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:ui="urn:packhelper:controls" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="ControlLine" Color="#755C4C" />
  <Style TargetType="ToolTip">
    <Setter Property="Background" Value="{DynamicResource Sidebar}" />
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ControlLine}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="14,10" />
    <Setter Property="MaxWidth" Value="350" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="HasDropShadow" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToolTip">
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="SquareFocus" TargetType="Control">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate>
          <Border BorderBrush="{DynamicResource Accent}" BorderThickness="0,0,0,2" Margin="2,0,2,-4" IsHitTestVisible="False" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="ActionFocus" TargetType="Control">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate>
          <Border BorderBrush="#2D170C" BorderThickness="0,0,0,2" Margin="12,0,12,3" IsHitTestVisible="False" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <SolidColorBrush x:Key="Action" Color="#F4AA74" />
  <SolidColorBrush x:Key="ActionText" Color="#2D170C" />
  <Style x:Key="KeyboardFocus" TargetType="Control">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate>
          <Border BorderBrush="{DynamicResource Accent}" BorderThickness="0,0,0,2" Margin="12,0,12,3" IsHitTestVisible="False" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <SolidColorBrush x:Key="Canvas" Color="#160F0C" />
  <SolidColorBrush x:Key="Sidebar" Color="#1B1410" />
  <SolidColorBrush x:Key="Surface" Color="#241B16" />
  <SolidColorBrush x:Key="Hover" Color="#3A281D" />
  <SolidColorBrush x:Key="Text" Color="#FFF2E8" />
  <SolidColorBrush x:Key="Muted" Color="#C2AA98" />
  <SolidColorBrush x:Key="Accent" Color="#FFB073" />
  <SolidColorBrush x:Key="Tint" Color="#4A2C1B" />
  <SolidColorBrush x:Key="Line" Color="#51382A" />
  <SolidColorBrush x:Key="Success" Color="#B8D9AE" />
  <SolidColorBrush x:Key="Danger" Color="#FFB5A1" />
  <Style TargetType="Image">
    <Setter Property="SnapsToDevicePixels" Value="False" />
    <Setter Property="RenderOptions.EdgeMode" Value="Unspecified" />
    <Setter Property="Stretch" Value="Uniform" />
  </Style>
  <Style TargetType="TextBlock">
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="LineHeight" Value="23" />
  </Style>
  <Style x:Key="Body" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
    <Setter Property="Foreground" Value="{DynamicResource Muted}" />
    <Setter Property="Margin" Value="0,8,0,0" />
  </Style>
  <Style x:Key="Section" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Margin" Value="0,20,0,6" />
  </Style>
  <Style TargetType="Button" x:Key="Secondary">
    <Setter Property="Background" Value="{DynamicResource Surface}" />
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="MinHeight" Value="46" />
    <Setter Property="Padding" Value="17,10" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <ui:CrispBorder x:Name="Face" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" />
            <ui:CrispBorder x:Name="HoverLayer" Background="#FFFFFF" Opacity="0" CornerRadius="8" IsHitTestVisible="False" />
            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="True" TextElement.Foreground="{TemplateBinding Foreground}" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="HoverLayer" Property="Opacity" Value="0.06" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Face" Property="Opacity" Value="0.72" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}" />
  </Style>
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource Secondary}">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Background" Value="{DynamicResource Action}" />
    <Setter Property="Foreground" Value="#2D170C" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="MinWidth" Value="154" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource ActionFocus}" />
  </Style>
  <Style x:Key="Quiet" TargetType="Button" BasedOn="{StaticResource Secondary}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource Muted}" />
  </Style>
  <Style x:Key="Nav" TargetType="Button" BasedOn="{StaticResource Quiet}">
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Padding" Value="13,12" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Margin" Value="0,4" />
  </Style>
  <Style TargetType="TextBox">
    <Setter Property="Background" Value="{DynamicResource Sidebar}" />
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
    <Setter Property="CaretBrush" Value="{DynamicResource Accent}" />
    <Setter Property="SelectionBrush" Value="#754426" />
    <Setter Property="BorderBrush" Value="{DynamicResource ControlLine}" />
    <Setter Property="Padding" Value="12,10" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <ui:CrispBorder x:Name="Field" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6">
            <ScrollViewer x:Name="PART_ContentHost" Margin="0" />
          </ui:CrispBorder>
          <ControlTemplate.Triggers>
            <Trigger Property="IsReadOnly" Value="True">
              <Setter TargetName="Field" Property="Background" Value="Transparent" />
              <Setter TargetName="Field" Property="BorderBrush" Value="{DynamicResource Line}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="Field" Property="BorderBrush" Value="{DynamicResource Accent}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="CheckBox">
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource SquareFocus}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions>
          <ui:CrispBorder x:Name="Box" Width="20" Height="20" VerticalAlignment="Top" Margin="0,2,0,0" Background="{DynamicResource Sidebar}" BorderBrush="{DynamicResource Muted}" BorderThickness="1" CornerRadius="3">
            <Viewbox x:Name="Tick" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
              <Canvas Width="24" Height="24"><Path Data="M5 12 L10 17 L19 7" Stroke="#2D170C" StrokeThickness="2.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" /></Canvas>
            </Viewbox>
          </ui:CrispBorder>
          <ContentPresenter Grid.Column="1" Margin="12,0,0,0" RecognizesAccessKey="True" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Box" Property="Background" Value="{DynamicResource Accent}" />
              <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="ListBoxItem">
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Margin" Value="0,0,0,8" />
    <Setter Property="Padding" Value="17,13" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <ui:CrispBorder x:Name="Row" BorderBrush="{DynamicResource Line}" Background="{DynamicResource Surface}" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
            <ContentPresenter />
          </ui:CrispBorder>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Row" Property="Background" Value="{DynamicResource Hover}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource Accent}" />
              <Setter TargetName="Row" Property="Background" Value="{DynamicResource Tint}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource Accent}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
  </Style>
  <Style TargetType="ScrollBar">
    <Setter Property="Width" Value="7" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MaxWidth" Value="7" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Track x:Name="PART_Track" IsDirectionReversed="True">
            <Track.DecreaseRepeatButton>
              <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
            </Track.DecreaseRepeatButton>
            <Track.Thumb>
              <Thumb>
                <Thumb.Template>
                  <ControlTemplate TargetType="Thumb">
                    <ui:CrispBorder Background="#87644D" CornerRadius="3" Margin="2,0" />
                  </ControlTemplate>
                </Thumb.Template>
              </Thumb>
            </Track.Thumb>
            <Track.IncreaseRepeatButton>
              <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
            </Track.IncreaseRepeatButton>
          </Track>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="ListBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBox">
          <Border Background="{TemplateBinding Background}">
            <ScrollViewer x:Name="PART_ScrollViewer" Focusable="False" CanContentScroll="True">
              <ItemsPresenter />
            </ScrollViewer>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.55" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="ProgressBar">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ProgressBar">
          <Grid x:Name="PART_Track" ClipToBounds="True">
            <ui:CrispBorder Background="{TemplateBinding Background}" CornerRadius="2" />
            <ui:CrispBorder x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left" CornerRadius="2" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsIndeterminate" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard x:Name="Pulse">
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="PART_Indicator" Storyboard.TargetProperty="Opacity" From="0.35" To="0.9" Duration="0:0:0.7" AutoReverse="True" RepeatBehavior="Forever" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <RemoveStoryboard BeginStoryboardName="Pulse" />
              </Trigger.ExitActions>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
