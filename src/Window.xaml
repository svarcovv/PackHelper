<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{DynamicResource Canvas}" SnapsToDevicePixels="True">
  <Grid.Resources>
    <SolidColorBrush x:Key="Canvas" Color="#FFF8F0"/><SolidColorBrush x:Key="Surface" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Text" Color="#39291E"/><SolidColorBrush x:Key="Muted" Color="#7C6456"/>
    <SolidColorBrush x:Key="Accent" Color="#B94E20"/><SolidColorBrush x:Key="AccentHover" Color="#A9441A"/>
    <SolidColorBrush x:Key="Tint" Color="#FFF0E3"/><SolidColorBrush x:Key="Line" Color="#EBD7C7"/>
    <SolidColorBrush x:Key="ControlLine" Color="#A7846C"/><SolidColorBrush x:Key="Success" Color="#2D714B"/><SolidColorBrush x:Key="Danger" Color="#B1372A"/>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="LineHeight" Value="21"/></Style>
    <Style x:Key="Secondary" TargetType="Button">
      <Setter Property="Background" Value="{DynamicResource Surface}"/><Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Setter Property="Padding" Value="15,9"/><Setter Property="MinHeight" Value="44"/>
      <Setter Property="Cursor" Value="Hand"/><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Focus" BorderThickness="2" BorderBrush="Transparent" CornerRadius="12">
          <Border x:Name="Body" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/></Border>
        </Border>
        <ControlTemplate.Triggers>
          <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True"/><Condition Property="Tag" Value="{x:Null}"/></MultiTrigger.Conditions><Setter TargetName="Body" Property="Background" Value="{DynamicResource Tint}"/></MultiTrigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Focus" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource Secondary}">
      <Setter Property="Tag" Value="Primary"/><Setter Property="Background" Value="{DynamicResource Accent}"/><Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter Property="FontSize" Value="15"/><Setter Property="MinHeight" Value="50"/>
      <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource AccentHover}"/></Trigger></Style.Triggers>
    </Style>
    <Style x:Key="Link" TargetType="Button" BasedOn="{StaticResource Secondary}"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource Muted}"/><Setter Property="Padding" Value="8,5"/></Style>
    <Style TargetType="ComboBoxItem"><Setter Property="Padding" Value="12,10"/><Setter Property="MinHeight" Value="42"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="Row" Background="{DynamicResource Surface}" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource Tint}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource Tint}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ComboBox"><Setter Property="MinHeight" Value="48"/><Setter Property="FontSize" Value="14"/><Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="ItemTemplate"><Setter.Value><DataTemplate><TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/></DataTemplate></Setter.Value></Setter>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid>
        <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" ClickMode="Press"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border CornerRadius="10" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource ControlLine}" BorderThickness="1"><Path Data="M 0 0 L 5 5 L 10 0" Stroke="{DynamicResource Muted}" StrokeThickness="1.7" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,17,0"/></Border></ControlTemplate></ToggleButton.Template></ToggleButton>
        <ContentPresenter Margin="14,10,42,10" VerticalAlignment="Center" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
        <Border x:Name="KeyboardRing" IsHitTestVisible="False" CornerRadius="10" BorderThickness="2" BorderBrush="Transparent"/>
        <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False" IsOpen="{TemplateBinding IsDropDownOpen}"><Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="280" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource ControlLine}" BorderThickness="1" CornerRadius="10" Padding="5" Margin="0,5,0,0"><ScrollViewer CanContentScroll="True"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer></Border></Popup>
      </Grid><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="KeyboardRing" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
  </Grid.Resources>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="28,19,28,15"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Image x:Name="HeaderIcon" Width="25" Height="25" Margin="0,0,11,0"/><TextBlock Text="PackHelper" FontSize="21" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
    <Button x:Name="CheckUpdates" Grid.Column="1" Style="{StaticResource Link}" AutomationProperties.Name="Проверить обновления"><StackPanel Orientation="Horizontal"><Image x:Name="RefreshIcon" Width="17" Height="17" Margin="0,0,8,0"/><TextBlock Text="Проверить обновления" Foreground="{DynamicResource Muted}"/></StackPanel></Button>
  </Grid>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="28,0,28,8">
    <StackPanel>
      <TextBlock Text="Ресурспак для LavaBox" FontSize="27" FontWeight="SemiBold" LineHeight="35" Margin="0,7,0,6"/>
      <TextBlock Text="Выбери сборку и установи пак. При входе Minecraft применит его сам." Foreground="{DynamicResource Muted}" Margin="0,0,0,23"/>
      <Border Background="{DynamicResource Surface}" CornerRadius="16" Padding="21" BorderBrush="{DynamicResource Line}" BorderThickness="1"><StackPanel>
        <Grid Margin="0,0,0,11"><TextBlock Text="Сборка Minecraft" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center"/><Button x:Name="Rescan" Content="Найти снова" HorizontalAlignment="Right" Style="{StaticResource Link}" Margin="0,-8,-8,-7"/></Grid>
        <ComboBox x:Name="Games" AutomationProperties.Name="Сборка Minecraft"/>
        <TextBlock x:Name="GamePath" Foreground="{DynamicResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,7,0,12"/>
        <WrapPanel><Button x:Name="BrowseFolder" AutomationProperties.Name="Выбрать папку" Style="{StaticResource Secondary}" Margin="0,0,8,0"><StackPanel Orientation="Horizontal"><Image x:Name="FolderIcon" Width="18" Height="18" Margin="0,0,8,0"/><TextBlock Text="Выбрать папку"/></StackPanel></Button><Button x:Name="BrowseLog" AutomationProperties.Name="Найти по логу" Style="{StaticResource Secondary}"><StackPanel Orientation="Horizontal"><Image x:Name="LogIcon" Width="18" Height="18" Margin="0,0,8,0"/><TextBlock Text="Найти по логу"/></StackPanel></Button></WrapPanel>
        <TextBlock x:Name="GameNote" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,12,0,0"/>
      </StackPanel></Border>
      <Grid Margin="0,23,0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Border Background="{DynamicResource Tint}" CornerRadius="13" Width="57" Height="57" VerticalAlignment="Top"><Image x:Name="PackIcon" Width="29" Height="29"/></Border>
        <StackPanel Grid.Column="1" Margin="14,1,12,0"><TextBlock x:Name="PackTitle" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="PackDetail" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,3,0,0"/><TextBlock x:Name="PackState" FontSize="13" Margin="0,5,0,0"/></StackPanel>
        <Image x:Name="StateIcon" Grid.Column="2" Width="22" Height="22" VerticalAlignment="Center"/>
      </Grid>
      <Border x:Name="UpdatePanel" Background="{DynamicResource Tint}" CornerRadius="13" Padding="17" Margin="0,0,0,18" Visibility="Collapsed"><StackPanel><TextBlock x:Name="UpdateTitle" FontWeight="SemiBold" FontSize="15"/><TextBlock x:Name="UpdateDetail" Foreground="{DynamicResource Muted}" Margin="0,6,0,0" FontSize="13"/><Button x:Name="DownloadUpdate" Style="{StaticResource Secondary}" HorizontalAlignment="Left" Margin="0,12,0,0" Content="Обновить приложение" Visibility="Collapsed"/></StackPanel></Border>
      <CheckBox x:Name="GameClosed" FontSize="14" Foreground="{DynamicResource Text}" Margin="0,0,0,15" Padding="6,0,0,0" VerticalContentAlignment="Center" Content="Minecraft закрыт. Лаунчер можно оставить открытым."/>
      <Button x:Name="InstallPack" AutomationProperties.Name="Установить ресурспак" Style="{StaticResource Primary}"><StackPanel Orientation="Horizontal"><Image x:Name="InstallIcon" Width="20" Height="20" Margin="0,0,10,0"/><TextBlock x:Name="InstallLabel" Text="Установить ресурспак" Foreground="White" FontWeight="SemiBold" FontSize="15"/></StackPanel></Button>
      <ProgressBar x:Name="Progress" Height="4" Foreground="{DynamicResource Accent}" Background="{DynamicResource Tint}" Margin="0,13,0,0" Visibility="Collapsed"/>
      <TextBlock x:Name="Status" Text="Закрой Minecraft перед установкой." Foreground="{DynamicResource Muted}" FontSize="13" Margin="0,12,0,0" MinHeight="22" AutomationProperties.LiveSetting="Polite"/>
      <Expander x:Name="Details" Header="Подробности установки" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,12,0,0"><TextBox x:Name="Destination" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource Muted}" Padding="0,9" FontSize="12"/></Expander>
    </StackPanel>
  </ScrollViewer>
  <Grid Grid.Row="2" Margin="20,2,28,12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <Button x:Name="Source" AutomationProperties.Name="Открыть исходники на GitHub" Style="{StaticResource Link}"><StackPanel Orientation="Horizontal"><Image x:Name="GitHubIcon" Width="17" Height="17" Margin="0,0,7,0"/><TextBlock Text="Исходники" Foreground="{DynamicResource Muted}" FontSize="12"/></StackPanel></Button>
    <Button x:Name="Help" Grid.Column="1" Style="{StaticResource Link}" Content="Помощь" FontSize="12"/>
    <TextBlock x:Name="AppVersion" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" FontSize="12"/>
  </Grid>
</Grid>
